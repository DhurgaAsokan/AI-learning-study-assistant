import os
import json
import re
import gradio as gr

from pypdf import PdfReader
from google import genai


# ============================================================
# MEMORY
# ============================================================

MEMORY_FILE = "student_memory.json"


def load_memory():

    if os.path.exists(MEMORY_FILE):

        with open(MEMORY_FILE, "r") as f:
            return json.load(f)

    return {
        "name": "",
        "subject": "",
        "difficulty": "Medium",
        "quiz_scores": [],
        "weak_topics": []
    }


memory = load_memory()


def save_memory():

    with open(MEMORY_FILE, "w") as f:
        json.dump(memory, f, indent=4)


# ============================================================
# GLOBAL DOCUMENT TEXT
# ============================================================

document_text = ""


# ============================================================
# GEMINI CLIENT
# ============================================================

client = None


def set_api_key(api_key):

    global client

    if not api_key:
        return "❌ Please enter your Gemini API key."

    try:

        client = genai.Client(api_key=api_key)

        return "✅ Gemini API connected successfully!"

    except Exception as e:

        return f"❌ API Error: {str(e)}"


# ============================================================
# PDF UPLOAD
# ============================================================

def upload_pdf(file):

    global document_text

    if file is None:

        return "❌ Please upload a PDF."

    try:

        reader = PdfReader(file.name)

        text = ""

        for page in reader.pages:

            page_text = page.extract_text()

            if page_text:
                text += page_text + "\n"

        document_text = text

        return (
            f"✅ PDF uploaded successfully!\n\n"
            f"Pages: {len(reader.pages)}\n"
            f"Characters extracted: {len(text)}"
        )

    except Exception as e:

        return f"❌ PDF Error: {str(e)}"


# ============================================================
# SIMPLE RAG RETRIEVAL
# ============================================================

def retrieve_context(question):

    if not document_text:

        return ""

    question_words = [
        word.lower()
        for word in re.findall(r"\b\w+\b", question)
        if len(word) > 2
    ]

    sentences = re.split(
        r"(?<=[.!?])\s+",
        document_text
    )

    scored = []

    for sentence in sentences:

        sentence_lower = sentence.lower()

        score = sum(
            word in sentence_lower
            for word in question_words
        )

        if score > 0:

            scored.append(
                (score, sentence)
            )

    scored.sort(
        key=lambda x: x[0],
        reverse=True
    )

    context = " ".join(
        sentence
        for score, sentence in scored[:15]
    )

    return context[:10000]


# ============================================================
# AI TUTOR
# ============================================================

def ask_ai(question):

    if client is None:

        return "❌ Please enter your Gemini API key first."

    if not question:

        return "❌ Please enter a question."

    context = retrieve_context(question)

    if context:

        prompt = f"""
You are an AI Learning Assistant.

Answer the student's question using the
study material provided below.

STUDY MATERIAL:
{context}

STUDENT QUESTION:
{question}

Rules:
1. Explain clearly.
2. Use simple student-friendly language.
3. Prefer the uploaded study material.
4. If the answer is not present in the material,
   clearly mention that.
"""

    else:

        prompt = f"""
You are an AI Learning Assistant.

Student Question:
{question}

No relevant information was found in the
uploaded study material.

Provide a helpful educational explanation.
"""

    try:

        response = client.models.generate_content(
            model="gemini-2.5-flash",
            contents=prompt
        )

        return response.text

    except Exception as e:

        return f"❌ Gemini Error: {str(e)}"


# ============================================================
# QUIZ TOOL
# ============================================================

def generate_quiz(topic, difficulty, number):

    if client is None:

        return "❌ Please connect Gemini first."

    if not topic:

        topic = memory["subject"]

    prompt = f"""
Create {number} multiple-choice questions.

Subject:
{memory["subject"]}

Topic:
{topic}

Difficulty:
{difficulty}

For every question provide:

Question
A.
B.
C.
D.
Correct Answer

Make the questions educational and suitable
for a college student.
"""

    try:

        response = client.models.generate_content(
            model="gemini-2.5-flash",
            contents=prompt
        )

        return response.text

    except Exception as e:

        return f"❌ Quiz Error: {str(e)}"


# ============================================================
# STUDY PLAN TOOL
# ============================================================

def create_study_plan(subject, days):

    if client is None:

        return "❌ Please connect Gemini first."

    weak_topics = ", ".join(
        memory["weak_topics"]
    )

    prompt = f"""
Create a personalized {days}-day study plan.

Student:
{memory["name"]}

Subject:
{subject}

Difficulty:
{memory["difficulty"]}

Weak Topics:
{weak_topics}

Create a practical plan.

For every day include:
- Topic
- Learning activity
- Practice activity
- Revision activity
"""

    try:

        response = client.models.generate_content(
            model="gemini-2.5-flash",
            contents=prompt
        )

        return response.text

    except Exception as e:

        return f"❌ Study Plan Error: {str(e)}"


# ============================================================
# MEMORY FUNCTIONS
# ============================================================

def save_profile(name, subject, difficulty):

    memory["name"] = name
    memory["subject"] = subject
    memory["difficulty"] = difficulty

    save_memory()

    return "✅ Student profile saved successfully!"


def save_score(score):

    memory["quiz_scores"].append(float(score))

    save_memory()

    if score >= 80:

        return "🎉 Excellent performance!"

    elif score >= 60:

        return "👍 Good performance. Keep practicing!"

    else:

        return "⚠️ You need more revision."


def add_weak_topic(topic):

    if not topic:

        return "❌ Enter a topic."

    if topic not in memory["weak_topics"]:

        memory["weak_topics"].append(topic)

        save_memory()

        return f"✅ '{topic}' added to weak topics."

    return "ℹ️ Topic already exists."


def show_progress():

    scores = memory["quiz_scores"]

    if scores:

        average = sum(scores) / len(scores)

    else:

        average = 0

    weak = ", ".join(
        memory["weak_topics"]
    )

    return f"""
## 📊 Learning Progress

**Student:** {memory["name"] or "Not set"}

**Subject:** {memory["subject"] or "Not set"}

**Difficulty:** {memory["difficulty"]}

**Quiz Attempts:** {len(scores)}

**Average Score:** {average:.1f}%

**Weak Topics:** {weak or "None"}

**Quiz Scores:** {scores or "No scores yet"}
"""


